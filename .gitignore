# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local Supabase connection values
supabase.json

# Blender automatic backups (editable .blend sources are tracked)
*.blend[0-9]*

# Private distribution signing materials
android/key.properties
**/signing.properties
*.jks
*.keystore
*.p12
*.mobileprovision

# Generated beta installers remain local
/docs/beta/*.apk

# QA media is generated during verification and remains local.
# Keep Markdown verification notes in Git.
/docs/qa/**/*.png
/docs/qa/**/*.jpg
/docs/qa/**/*.jpeg
/docs/qa/**/*.webp
/docs/qa/**/*.mp4
/docs/qa/**/*.mov

# Licensed Vital media and locally staged app assets stay on this machine.
/local_assets/vital_animations/
/assets/vital_videos/*.mp4
/assets/vital_thumbnails/*.png

# Licensed Vital media - keep only local
/assets/vital_videos/*
!/assets/vital_videos/.gitkeep
/assets/vital_thumbnails/*
!/assets/vital_thumbnails/.gitkeep

# Locally rendered SETKEEP form videos and thumbnails are staged with the app.
/assets/exercise_videos/*.mp4
/assets/exercise_thumbnails/*.png
